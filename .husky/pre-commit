#!/usr/bin/env sh
# Waykit - Pre-Commit Quality & Security Gate (Husky)
# Husky invokes hooks with `sh`; keep this POSIX-compatible.
set -eu

REPO_DIR="$(git rev-parse --show-toplevel)"

echo "=== Pre-Commit Quality & Security Gate ==="

"${REPO_DIR}/bin/kit" audit
"${REPO_DIR}/bin/kit" validate
"${REPO_DIR}/bin/kit" verify
"${REPO_DIR}/bin/kit" ontology check
(cd "${REPO_DIR}" && pnpm typecheck)
(cd "${REPO_DIR}/web" && pnpm typecheck)
(cd "${REPO_DIR}/web" && pnpm test:mermaid)

echo "✅ Pre-commit quality gate PASSED."
