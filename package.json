{
  "name": "agent-lifecycle-kit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Modular agent lifecycle guardrails, skills, and tooling",
  "bin": {
    "kit": "./bin/kit",
    "agent-kit": "./bin/kit"
  },
  "scripts": {
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c .oxlintrc.json kit/src mcps/servers bin",
    "kit": "node --import tsx/esm bin/kit.ts",
    "test": "node --import tsx/esm --test 'kit/src/**/*.test.ts' mcps/servers/kit-knowledge/src/knowledge.test.ts",
    "test:ci": "mkdir -p out/reports && node --import tsx/esm --test --test-reporter=spec --test-reporter=./kit/src/github_test_reporter.mjs --test-reporter-destination=stdout --test-reporter-destination=out/reports/unit-test-report.md 'kit/src/**/*.test.ts' mcps/servers/kit-knowledge/src/knowledge.test.ts",
    "check": "pnpm lint && pnpm test && pnpm kit check"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "ajv": "^8.20.0",
    "husky": "^9.1.7",
    "oxlint": "^1.81.0",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.5.4"
  }
}
