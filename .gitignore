# Local runtime cache (see sync/README.md)
sync/*
!sync/README.md

# Per-project phase handovers (generated at runtime)
handover/*
!handover/README.md
!handover/.gitkeep

# Per-project kit lessons (captured at runtime; promoted via tasks/kit-review.md)
lessons/*
!lessons/README.md
!lessons/.gitkeep

# Machine-specific overrides (copy from config.example.json)
system/config.json

# Upstream Agent Skills (install via scripts/sync-external-skills.sh → ~/.cursor/skills)
# Only kit prefixes are committed: agent-*, profile-*, lang-*, framework-*
skills/*
!skills/README.md
!skills/external.lock.json
!skills/agent-*/
!skills/lang-*/
!skills/framework-*/
!skills/profile-*/

# OS / editor
.DS_Store
*.swp
*.swo
