# Local runtime cache (see sync/README.md)
sync/*
!sync/README.md

# Per-project phase handovers (generated at runtime)
handover/*
!handover/README.md
!handover/.gitkeep

# Per-project kit lessons (captured at runtime; promoted via tasks/kit-review.md)
lessons/*
!lessons/README.md
!lessons/.gitkeep

# Machine-specific overrides (copy from config.example.json)
system/config.json

# gh skill provenance lock written when scanning project scope — do not commit
.skill-lock.json

# Upstream Agent Skills (install via `kit sync` → ~/.cursor/skills)
# Only kit prefixes are committed: agent-*, profile-*, lang-*, framework-*
skills/*
!skills/README.md
!skills/external.lock.json
!skills/agent-*/
!skills/lang-*/
!skills/framework-*/
!skills/profile-*/

# Environment & secrets
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
credentials.json
node_modules/
.pnpm-store/

# EDD / eval report artifacts
out/

# OS / editor
.DS_Store
*.swp
*.swo
