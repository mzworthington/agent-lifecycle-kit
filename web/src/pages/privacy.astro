---
import SiteLayout from '../layouts/SiteLayout.astro';
import SiteChrome from '../components/SiteChrome.astro';
import { DOCS_PAGES } from '../docs/pages.ts';
import { resolvePageSeo } from '../seo/siteSeo.ts';

const seo = resolvePageSeo('/privacy');
const navPages = DOCS_PAGES.map(({ path, title }) => ({ path, title }));
---

<SiteLayout seo={seo}>
  <SiteChrome pathname="/privacy" pages={navPages}>
    <article class="docs-panel">
      <h1>Privacy policy</h1>
      <p>Last updated 3 September 2026.</p>
      <p>
        This page says what Waykit’s public site does with information when you use
        <a href="https://waykit.dev">waykit.dev</a>. It is a plain-language notice, not legal
        advice.
      </p>
      <p>
        The site is built by
        <a href="https://mzworthington.co.uk">Matthew Z Worthington</a>. The kit itself runs on
        your machine after you install it.
      </p>
      <h2>What stays on your machine</h2>
      <p>
        Installing Waykit copies skills and config into your home directory. We do not receive
        your local agent sessions, handovers, or product source from this website.
      </p>
      <h2>Product analytics (PostHog)</h2>
      <p>
        The public docs site uses <a href="https://posthog.com">PostHog</a> Cloud EU (via a
        first-party ingest host) so we can see which pages people open. We configure PostHog with
        <strong>cookieless tracking</strong>: it does not write PostHog cookies or use
        local/session storage for identity, and we do not call <code>identify()</code>. Counts
        use a privacy-preserving hash on PostHog’s servers. Session replay is off on this site.
      </p>
      <p>
        That is why this site does not show a cookie banner for PostHog. Cloudflare or the
        browser may still use their own cookies for hosting or security.
      </p>
      <p>PostHog’s own terms and privacy policy apply to data they process for us.</p>
      <h2>Hosting and Cloudflare analytics</h2>
      <p>
        The website is static files on <strong>GitHub Pages</strong> with DNS on Cloudflare. A
        separate Cloudflare Web Analytics beacon may run for visit counts. Those systems receive
        normal web-request metadata (for example IP address at the edge) as part of serving the
        site.
      </p>
      <h2>What we do not do</h2>
      <p>
        We do not sell your data. We do not run ads. You do not need an account to read these
        docs.
      </p>
      <h2>Asking us to delete something</h2>
      <p>
        If you think we hold personal data about you in PostHog or elsewhere, open an issue on
        <a href="https://github.com/mzworthington/waykit/issues">github.com/mzworthington/waykit</a>
        and say what you want removed. We will use PostHog’s deletion tools where they apply.
      </p>
      <h2>Changes</h2>
      <p>If this notice changes in a material way, we will update the date at the top.</p>
    </article>
  </SiteChrome>
</SiteLayout>
