{
  "id": "memory",
  "name": "Memory",
  "summary": "Typed local knowledge-graph memory (kit ontology allowlist on create).",
  "homepage": "https://github.com/mzworthington/waykit/tree/main/mcps/servers/memory",
  "transport": "stdio",
  "phases": ["spec", "impl", "telemetry"],
  "triggers": ["memory", "remember", "knowledge graph", "preferences", "glossary", "SLO"],
  "requiredEnv": [],
  "mcp": {
    "memory": {
      "command": "node",
      "args": [
        "--import",
        "${userHome}/.agents/node_modules/tsx/dist/esm/index.mjs",
        "${userHome}/.agents/mcps/servers/memory/src/server.ts"
      ],
      "env": {
        "KIT_ROOT": "${userHome}/.agents",
        "MEMORY_FILE_PATH": "${userHome}/.agents/sync/mcp-memory.jsonl"
      }
    }
  }
}
