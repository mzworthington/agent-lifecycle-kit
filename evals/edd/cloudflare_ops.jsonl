{"id": "cf-rum-01", "prompt": "List our Cloudflare Web Analytics / RUM sites.", "tags": ["happy-path", "routing"], "expect": {"tool": "execute", "arguments_contains": {"code": "async () => cloudflare.request({ method: \"GET\", path: `/accounts/${accountId}/rum/site_info/list` })"}}}
{"id": "cf-search-01", "prompt": "Find the Cloudflare API endpoint for listing RUM site_info.", "tags": ["happy-path", "routing"], "expect": {"tool": "search", "arguments_contains": {"code": "rum site_info list"}}}
{"id": "cf-obs-01", "prompt": "Query Worker logs for the insights beacon worker.", "tags": ["happy-path", "routing"], "expect": {"tool": "query_worker_observability", "arguments_contains": {"view": "events"}}}
{"id": "cf-ignore-01", "prompt": "What is the weather in Oslo?", "tags": ["negative-test", "conversational"], "expect": {"no_tool": true}}
{"id": "cf-live-01", "prompt": "Are we collecting RUM on the GitHub Pages origin, and can you pull the live site list?", "tags": ["semantic-variance", "routing", "requires-live"], "expect": {"tool": "execute", "arguments_contains": {"code": "async () => cloudflare.request({ method: \"GET\", path: `/accounts/${accountId}/rum/site_info/list` })"}}}
